# Required. Generate on NAS with: openssl rand -hex 32
MFI_BEARER_TOKEN=

# Pin to a verified release tag before production use.
MFI_IMAGE_TAG=latest

# Defaults from the upstream service; update USB ID after checking the device.
MFI_HTTP_PORT=8972
MFI_CH341_USB_IDS=1a86:5512
MFI_MFI_I2C_ADDRESS=0x11
MFI_CH341_I2C_SPEED_KHZ=100
MFI_LOG_LEVEL=info
MFI_LOG_FORMAT=json
